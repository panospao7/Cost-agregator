            item {
                Text(
                    "❌ Critical (${criticalIssues.size})",
                    style = MaterialTheme.typography.titleMedium,
                    fontWeight = FontWeight.Bold,
                    color = MaterialTheme.colorScheme.error
                )
            }
            items(criticalIssues) { issue ->
                IssueCard(issue, Color(0xFFEF5350))
