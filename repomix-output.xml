        val result = revolutParser.parse(
            title = "Paid €12.50 at SKLAVENITIS",
            text = null,
            bigText = null,
            subText = null,
            packageName = "com.revolut.revolut"
        )
        assertNotNull(result)
        val key = MerchantKeyGenerator.generate(result!!.merchant)
        assertEquals("sklavenitis", key)
