    val parts = buildList {
        add(routeLabel)
        providerLabel?.takeIf { it.isNotBlank() }?.let(::add)
        modelLabel?.takeIf { it.isNotBlank() }?.let(::add)
    }
    return parts.joinToString(" - ")
}
