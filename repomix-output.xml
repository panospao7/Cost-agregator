    @Test
    fun `invoke returns merchant breakdown`() = runTest {
        coEvery { expenseRepository.getTopMerchantsForPeriod(100L, 200L, 8) } returns listOf(
            MerchantStats("lidl", "Lidl", 50.0, 3, 16.6, 10.0, 30.0, 101L, 199L)
