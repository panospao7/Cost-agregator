        coEvery {
            expenseRepository.getExpensesPagedDynamic(any(), any(), any(), any(), any(), any(), any(), any(), any(), any(), any())
        } returns listOf(
            ExpenseWithCategory(
                expense = Expense(
                    id = 1L,
                    amount = 12.0,
                    merchant = "Lidl",
                    transactionType = TransactionType.PURCHASE,
                    date = 150L
                ),
                category = null
