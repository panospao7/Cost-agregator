    }

    // ============================================================================
    // SECTION 3: TRANSFER DIRECTION COMBINATIONS
    // ============================================================================

    @Test
    fun `stress - all transaction types create correctly`() {
        TransactionType.entries.forEach { type ->
            val expense = Expense(
                amount = 100.0,
                merchant = "Test",
                transactionType = type,
                date = System.currentTimeMillis()
            )
