        viewModel.simulateDepositNotification()
        advanceUntilIdle()

        coVerify(exactly = 1) {
            repository.processAndSave(match {
                it.title == "Deposit Received" && !it.text.isNullOrBlank()
            })
        }
        assertFalse(viewModel.isSimulating.value)
    }
