class RevolutParserStressTest {

    // ============================================================================
    // SECTION 1: PURCHASE PARSING
    // ============================================================================

    @Test
    fun `stress - parse Revolut purchase notification`() {
        val notifications = listOf(
            "Paid €12.50 at SKLAVENITIS",
