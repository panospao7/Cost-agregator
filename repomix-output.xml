            amount = 100.0,
            merchant = "Shop",
            transactionType = TransactionType.PURCHASE,
            date = System.currentTimeMillis(),
            isSharedExpense = true,
            mySharePercentage = null,
            myShareAmount = null
        )
        
        // Both null - should return full amount
