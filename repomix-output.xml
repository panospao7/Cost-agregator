    val routeLabel = when (mode) {
        AiMode.ON_DEVICE -> "On-device"
        AiMode.CLOUD -> "Cloud"
        AiMode.AUTO -> return null
    }

    return AiArtifactDiagnostics(
        routeLabel = routeLabel,
        providerLabel = provider,
        modelLabel = modelName
    )
