            }
        }
        
        // Info
        groupedIssues[IssueSeverity.INFO]?.let { infoIssues ->
            item {
                Text(
                    "💡 Info (${infoIssues.size})",
                    style = MaterialTheme.typography.titleMedium,
                    fontWeight = FontWeight.Bold,
