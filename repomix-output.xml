            item {
                Text(
                    "⚠️ Warnings (${warnings.size})",
                    style = MaterialTheme.typography.titleMedium,
                    fontWeight = FontWeight.Bold,
                    color = Color(0xFFFFA726)
                )
            }
            items(warnings) { issue ->
