    suspend fun insert(mapping: MerchantCategory) = dao.insert(mapping)

    suspend fun deleteAll() = dao.deleteAll()

    /**
     * Learns a merchant -> category mapping.
     * Uses Provider to break circular dependency with CategorizationEngine.
     */
