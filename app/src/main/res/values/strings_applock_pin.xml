    <!-- S27 b1: App PIN setup, change and remove steps (ux-flows 9.3). -->
    <string name="applock_pin_setup_title">Set an app PIN</string>
    <string name="applock_pin_setup_intro">Choose a PIN of 6 to 12 digits. It\'s asked for instead of your phone\'s screen lock when you open this app, which helps keep out people who know your phone\'s screen lock.</string>
    <string name="applock_pin_setup_warning">If you forget this PIN, the only way back in is to erase the app\'s data. Your data can then only be restored from a backup file you exported (.costbackup), with its password. Backups kept only inside the app are erased too.</string>
    <string name="applock_pin_setup_backup_now">Back up now</string>
