3. Open Bill Reminders:
   expensetracker://bills
   expensetracker://reminders

4. Open Spending Challenges:
   expensetracker://challenges

5. Open Advanced Analytics:
   expensetracker://advanced_analytics

6. With parameters (for notifications):
   expensetracker://bills?urgent=true
   expensetracker://challenges?achievement=7day
   expensetracker://investments?alert=target_hit

Integration Code in MainActivity.kt:

private fun handleIntent(intent: android.content.Intent?) {
    val data = intent?.data ?: return
    if (data.scheme == "expensetracker") {
        when (data.host) {
            // Existing handlers
            "dashboard" -> mainViewModel.navigateToTab(0)
            "activity" -> mainViewModel.navigateToTab(1)
            ...
            
            // NEW: Phase 4 handlers
            "investments" -> {
                // Show investment portfolio
                showInvestmentPortfolio = true
            }
            "banks" -> {
                // Show bank connections
                showBankConnections = true
            }
            "bills", "reminders" -> {
                // Show bill reminders
                showBillReminders = true
            }
            "challenges" -> {
                // Show spending challenges
                showSpendingChallenges = true
            }
            "advanced_analytics" -> {
                // Show advanced analytics
                showAdvancedAnalytics = true
            }
        }
    }
}

