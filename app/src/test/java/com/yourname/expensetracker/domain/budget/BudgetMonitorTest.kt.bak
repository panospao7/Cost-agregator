package com.yourname.expensetracker.domain.budget

import android.content.Context
import com.yourname.expensetracker.data.database.dao.BudgetDao
import com.yourname.expensetracker.data.database.dao.CategoryDao
import com.yourname.expensetracker.data.database.dao.CategoryTotal
import com.yourname.expensetracker.data.database.dao.ExpenseDao
import com.yourname.expensetracker.data.database.entity.Budget
import com.yourname.expensetracker.data.database.entity.BudgetPeriod
import com.yourname.expensetracker.data.database.entity.Category
import io.mockk.*
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.ExperimentalCoroutinesApi
import kotlinx.coroutines.test.StandardTestDispatcher
import kotlinx.coroutines.test.resetMain
import kotlinx.coroutines.test.setMain
import org.junit.After
import org.junit.Assert.assertEquals
import org.junit.Before
import org.junit.Test
import java.util.Calendar

@OptIn(ExperimentalCoroutinesApi::class)
class BudgetMonitorTest {

    private val context = mockk<Context>(relaxed = true)
    private val budgetDao = mockk<BudgetDao>(relaxed = true)
    private val expenseDao = mockk<ExpenseDao>(relaxed = true)
    private val categoryDao = mockk<CategoryDao>(relaxed = true)
    
    private lateinit var monitor: BudgetMonitor

    @Before
    fun setup() {
        // Dispatchers.IO is hardcoded in BudgetMonitor, so we can't easily swap it without refactoring.
        // But for unit tests of logic functions like calculatePeriodWindow, we don't need coroutines.
        // For checkBudgets, we will rely on verify(timeout) or arguably refactor to inject dispatchers.
        // Since we are adding tests to existing code, we'll try to use the verify approach first.
        
        monitor = BudgetMonitor(context, budgetDao, expenseDao, categoryDao)
    }

    // =========================================================================
    // PERIOD CALCULATION LOGIC
    // =========================================================================
    
    @Test
    fun `calculatePeriodWindow MONTHLY returns correct start and end`() {
        // Anchor: Jan 15th, 2024
        val anchorCal = Calendar.getInstance()
        anchorCal.set(2024, Calendar.JANUARY, 15, 0, 0, 0)
        val anchorMs = anchorCal.timeInMillis
        
        // Target Date: Jan 20th, 2024 (Within the cycle)
        // Cycle should be Jan 15 - Feb 15
        val targetCal = Calendar.getInstance()
        targetCal.set(2024, Calendar.JANUARY, 20, 12, 0, 0) // noon
        
        // We need to access private calculatePeriodWindowForTime via public calculatePeriodWindow wrapper?
        // Wait, calculatePeriodWindowForTime is private.
        // But calculatePeriodWindow calls it with System.currentTimeMillis().
        // Does BudgetMonitor expose a way to pass time?
        // No.
        // However, `calculatePeriodWindow` is public and takes `period` and `anchorDate`.
        // It uses `System.currentTimeMillis()`. This makes it untestable for specific dates unless we mock System.
        // OR we just accept we can only test "Current" window relative to now.
        
        // But the method `calculatePeriodWindowForTime` is private.
        // `calculatePeriodWindow(period, anchor)` calls it.
        
        // WORKAROUND: We can't easily test `calculatePeriodWindow` for arbitrary dates without refactoring or mocking System.currTime.
        // BUT, we can test that for a Monthly budget starting TODAY, the window is today -> next month.
        
        val now = System.currentTimeMillis()
        val window = monitor.calculatePeriodWindow(BudgetPeriod.MONTHLY, now)
        
        val startCal = Calendar.getInstance()
        startCal.timeInMillis = window.first
        
        val endCal = Calendar.getInstance()
        endCal.timeInMillis = window.second
        
        val nowCal = Calendar.getInstance()
        nowCal.timeInMillis = now
        
        // Start should be today (day of month match)?
        // Logic: 
        // cal.set(Calendar.DAY_OF_MONTH, anchorDay)
        // If query time < calculated start, move back a month.
        // Since anchor is today, it should match.
        
        assertEquals(nowCal.get(Calendar.DAY_OF_MONTH), startCal.get(Calendar.DAY_OF_MONTH))
        assertEquals(nowCal.get(Calendar.MONTH), startCal.get(Calendar.MONTH))
        
        // End should be next month
        val expectedEndMonth = (nowCal.get(Calendar.MONTH) + 1) % 12
        assertEquals(expectedEndMonth, endCal.get(Calendar.MONTH))
    }

    @Test
    fun `calculatePeriodWindow WEEKLY aligned to anchor day`() {
        // Anchor: A Monday
        val anchorCal = Calendar.getInstance()
        anchorCal.set(2024, Calendar.JANUARY, 1, 0, 0, 0) // Jan 1 2024 was Monday
        val anchorMs = anchorCal.timeInMillis
        
        val window = monitor.calculatePeriodWindow(BudgetPeriod.WEEKLY, anchorMs)
        
        val startCal = Calendar.getInstance()
        startCal.timeInMillis = window.first
        
        // Start day of week must be Monday (Calendar.MONDAY = 2)
        assertEquals(Calendar.MONDAY, startCal.get(Calendar.DAY_OF_WEEK))
        
        // End should be 7 days later
        val durationStartToEnd = window.second - window.first
        val sevenDaysMs = 7L * 24 * 60 * 60 * 1000
        // Approx check due to DST or leap seconds? Standard UTC math usually exact for 7 days.
        // But Calendar might handle DST.
        // Let's check day diff.
        // It should be exactly 7 days difference in calendar time.
        // Or roughly close.
        assertEquals(sevenDaysMs.toDouble(), durationStartToEnd.toDouble(), 3600000.0 * 25) // within a day (DST safe)
    }

    // =========================================================================
    // NOTIFICATION LOGIC
    // =========================================================================

    @Test
    fun `checkBudgets triggers warning notification when threshold exceeded`() {
        val budget = Budget(
            id = 1,
            amount = 100.0,
            categoryId = 1,
            period = BudgetPeriod.MONTHLY,
            startDate = System.currentTimeMillis(),
            notifyAtWarning = 0.5f, // 50%
            notifyAtCritical = 0.9f,
            lastWarningNotifiedAt = null
        )
        
        coEvery { budgetDao.getActiveBudgets() } returns listOf(budget)
        coEvery { categoryDao.getByIds(any()) } returns listOf(Category(id=1, name="Groceries", icon="", color=""))
        
        // Return 60.0 spent (60%)
        coEvery { expenseDao.getCategoryTotalsForPeriod(any(), any()) } returns listOf(
             com.yourname.expensetracker.data.database.entity.CategoryTotal(1, 60.0, 1)
        )
        
        monitor.checkBudgets()
        
        // Verify notification fired
        verify(timeout = 2000) { 
            budgetDao.updateWarningNotification(1, any()) 
        }
        
        // Verify notification manager called (via Context)
        // Since we mocked Context, we can't verify NotificationManager.notify unless we mocked getSystemService
        // But we verified that updateWarningNotification was called, which implies the logic reached that point.
    }

    @Test
    fun `checkBudgets does NOT notify if cooldown is active`() {
        val now = System.currentTimeMillis()
        val recentReset = now - (1 * 60 * 60 * 1000) // 1 hour ago
        
        val budget = Budget(
            id = 1,
            amount = 100.0,
            categoryId = 1,
            period = BudgetPeriod.MONTHLY,
            startDate = now,
            notifyAtWarning = 0.5f,
            lastWarningNotifiedAt = recentReset // Cooldown active!
        )
        
        coEvery { budgetDao.getActiveBudgets() } returns listOf(budget)
        coEvery { categoryDao.getByIds(any()) } returns listOf(Category(id=1, name="Groceries", icon="", color=""))
        coEvery { expenseDao.getCategoryTotalsForPeriod(any(), any()) } returns listOf(
             com.yourname.expensetracker.data.database.entity.CategoryTotal(1, 60.0, 1) // 60% > 50%
        )
        
        monitor.checkBudgets()
        
        // Should NOT update notification time
        verify(exactly = 0, timeout = 1000) { 
            budgetDao.updateWarningNotification(any(), any()) 
        }
    }
}
