{
  "$schema": "https://opencode.ai/config.json",

  "default_agent": "orchestrator",

  "model": "merge-gateway/glm-5.3-flash",
  "small_model": "merge-gateway/glm-5.3-flash",

  "provider": {
    "freemodel": {
      "npm": "@ai-sdk/anthropic",
      "options": {
        "baseURL": "https://cc-t2.freemodel.dev/v1",
        "apiKey": "{env:FREEMODEL_API_KEY}"
      },
      "models": {
        "claude-sonnet-5": {
          "name": "Sonnet 5",
          "options": {
            "thinking": { "type": "enabled", "budgetTokens": 4096 },
            "maxTokens": 8000
          }
        },
        "claude-opus-5": {
          "name": "Opus 5",
          "options": {
            "thinking": { "type": "enabled", "budgetTokens": 20000 },
            "maxTokens": 32000
          }
        }
      }
    }
  },

  "share": "manual",

  "permission": {
    "edit": "ask",
    "bash": "ask"
  },

  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  },

  "watcher": {
    "ignore": [
      ".git/**",
      ".gradle/**",
      ".kotlin/**",
      "**/build/**",
      "app/build/**",
      "*.db",
      "*.sqlite",
      "repomix-output.xml",
      "extracted_codebase/**",
      "validation-*.txt",
      "build_log.txt",
      "test_output.txt"
    ]
  },

  "instructions": [
    "AGENTS.md"
  ]
}
